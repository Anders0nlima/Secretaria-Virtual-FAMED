# =========================
# Backend (Python / FastAPI)
# =========================

# Ambientes virtuais
.venv/
venv/
env/

# Arquivos de ambiente (contêm variáveis sensíveis, só .env.example deve ir para o git)
.env
.env.*
!.env.example

# Banco de dados vetorial (gerado automaticamente)
backend/chroma_db/
chroma_db/

# Arquivos temporários e cache do Python
__pycache__/
*.py[cod]
*.class
.pytest_cache/

# =========================
# Frontend (React / Vite)
# =========================
# O frontend já tem seu próprio .gitignore, mas é boa prática colocar na raiz também
node_modules/
dist/
dist-ssr/
*.local

# =========================
# Sistema Operacional e IDEs
# =========================
.DS_Store
Thumbs.db
.vscode/
.idea/

# Credenciais e chaves de APIs (Google Service Account, OAuth, etc.)
credentials/
backend/credentials/
*.json.secret
*serviceaccount*.json
*service-account*.json

# Logs e arquivos de depuração
*.log

# Scripts temporários de correção e testes pontuais da raiz do backend
backend/fix_*.py
backend/patch_*.py
backend/test_*.py
backend/apply_*.py
backend/debug_*.py
backend/list_*.py
backend/restore_*.py
backend/setup_*.py
backend/update_*.py

# Dados de e-mail e relatórios intermediários (LGPD / Privacidade)
backend/data/email_raw/
*.mbox
backend/data/emails_anonymized*
backend/data/email_inventory_report*
backend/data/feedback*.jsonl
