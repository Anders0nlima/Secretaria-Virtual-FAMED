# Modelo Ollama a ser utilizado
OLLAMA_MODEL=gemma3:4b

# URL base do Ollama (padrão local)
OLLAMA_BASE_URL=http://localhost:11434

# Modelo de embeddings (HuggingFace)
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Caminho para o PDF do calendário
PDF_PATH=data/Calendario_Academico_da_UFPA_2026.pdf

# Caminho onde o ChromaDB será persistido
CHROMA_PATH=chroma_db

# Nome da coleção no ChromaDB
CHROMA_COLLECTION=calendario_2026

# Número de chunks recuperados por busca
RETRIEVER_K=4
